# Shopify App Credentials (from Shopify Partners Dashboard)
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_customers,write_customers,read_metafields,write_metafields,read_inventory,write_inventory

# App URL (your Vercel deployment URL)
NEXT_PUBLIC_APP_URL=https://charm-craft-app.vercel.app
HOST=https://charm-craft-app.vercel.app

# Database (Vercel Postgres or SQLite for dev)
DATABASE_URL=file:./dev.db

# Session secret (any random 32+ character string)
SESSION_SECRET=change_this_to_a_random_32_character_string

# Your dev store for testing
SHOPIFY_STORE=jewellery-app-3.myshopify.com
