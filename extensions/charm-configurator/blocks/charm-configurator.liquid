{{ 'charm-configurator.css' | asset_url | stylesheet_tag }}

<div id="cc-root"></div>

<script
  data-storefront-token="{{ shop.metafields.charm_craft.storefront_token | default: '31f6559e0489e73fb811a461b6950878' }}"
  data-shop="{{ shop.permanent_domain }}"
></script>

{{ 'charm-configurator.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Charm Configurator",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Build Your Necklace"
    },
    {
      "type": "range",
      "id": "max_charms",
      "label": "Max Charms",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ]
}
{% endschema %}
