{% comment %} Charm Craft Configurator — Theme Block {% endcomment %}

<div
  id="charm-craft-root"
  data-shop="{{ shop.permanent_domain }}"
  data-storefront-token="{{ shop.metafields.cc_app.storefront_token | default: '' }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-customer-id="{{ customer.id | default: '' }}"
  data-app-url="{{ block.settings.app_url }}"
  data-max-charms="{{ block.settings.max_charms | default: 8 }}"
  data-enable-engraving="{{ block.settings.enable_engraving | default: true }}"
  data-title="{{ block.settings.configurator_title | default: 'Build Your Necklace' }}"
>
  <div id="cc-loading" style="text-align:center;padding:4rem;font-family:sans-serif;">
    <div style="display:inline-block;width:40px;height:40px;border:3px solid #f0e6d3;border-top-color:#c9a96e;border-radius:50%;animation:cc-spin 0.8s linear infinite;"></div>
    <p style="color:#666;margin-top:1rem;">Loading Charm Configurator...</p>
  </div>
</div>

<style>
  @keyframes cc-spin { to { transform: rotate(360deg); } }
  #charm-craft-root { min-height: 400px; }
</style>

{% if block.settings.custom_css != blank %}
<style>{{ block.settings.custom_css }}</style>
{% endif %}

<link rel="stylesheet" href="{{ 'charm-configurator.css' | asset_url }}" />
<script src="{{ 'charm-configurator.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Charm Configurator",
  "settings": [
    {
      "type": "text",
      "id": "configurator_title",
      "label": "Title",
      "default": "Build Your Necklace"
    },
    {
      "type": "url",
      "id": "app_url",
      "label": "App URL (Vercel deployment URL)"
    },
    {
      "type": "range",
      "id": "max_charms",
      "label": "Maximum charms",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "enable_engraving",
      "label": "Enable engraving",
      "default": true
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "Charm Configurator"
    }
  ]
}
{% endschema %}
